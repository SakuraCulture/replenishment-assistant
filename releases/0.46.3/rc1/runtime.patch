+"""Explain date-bound actions without changing the existing business-day rules."""
+
+
+def continue_today(day, today):
+    return (f'当前作业日期是 {day}，今天是 {today}。\n'
+            '请到“草稿记录”选中原记录，点击“用此配置新建今日草稿”，核对今日输入并重新计算后继续。原日期草稿保留。')
+
+
