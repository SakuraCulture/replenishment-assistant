{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:youtuan:aoxiang:command:1",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_version", "command_id", "operation", "account_binding", "scope", "basis_versions", "policy"],
  "properties": {
    "protocol_version": {"const": 1},
    "command_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$"},
    "operation": {"const": "replenishment.export"},
    "account_binding": {
      "type": "object", "additionalProperties": false,
      "required": ["account_id", "merchant_code"],
      "properties": {
        "account_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "merchant_code": {"type": "string", "minLength": 1, "maxLength": 128}
      }
    },
    "scope": {
      "type": "object", "additionalProperties": false,
      "required": ["warehouse_codes"],
      "properties": {
        "warehouse_codes": {"type": "array", "minItems": 1, "maxItems": 256, "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 128}}
      }
    },
    "basis_versions": {
      "type": "object", "additionalProperties": false,
      "required": ["store_mapping"],
      "properties": {"store_mapping": {"type": "string", "minLength": 1, "maxLength": 128}}
    },
    "policy": {
      "type": "object", "additionalProperties": false,
      "required": ["freshness"],
      "properties": {"freshness": {"enum": ["reuse", "refresh"]}}
    }
  }
}
